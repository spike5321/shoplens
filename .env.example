# ============================================================
# ShopLens 环境变量示例
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 真实 Key 只从环境变量读取：不写入源码、日志、仓库、截图。
# ============================================================

# ---------- 运行环境 ----------
SHOPLENS_ENV=local

# ---------- 数据库 ----------
# 三套凭据必须分离（计划第 4 节）：
#   1) admin    : 初始化 / 迁移 / 建角色        —— 最高权限，只用于 migrate、seed
#   2) app      : 应用状态读写（runs/events/…)  —— 后端服务使用
#   3) reader   : 分析视图只读                  —— 只给模型 SQL 执行用
# admin 仅供迁移/灌数；运行时与就绪探针使用 app/reader。

SHOPLENS_PG_HOST=127.0.0.1
SHOPLENS_PG_PORT=55432

SHOPLENS_PG_DB=shoplens

# (1) 初始化/迁移凭据 —— 拥有建表、建角色权限
SHOPLENS_PG_ADMIN_USER=postgres
SHOPLENS_PG_ADMIN_PASSWORD=

# (2) 应用状态读写凭据
SHOPLENS_PG_APP_USER=shoplens_app
SHOPLENS_PG_APP_PASSWORD=

# (3) 分析只读凭据
SHOPLENS_PG_READER_USER=analytics_reader
SHOPLENS_PG_READER_PASSWORD=

# ---------- 模型服务商 ----------
# 默认离线假模型（offline），无需 Key 即可开发与测试。
# 有 Key 时可显式启用 deepseek；只有实际运行并通过的检查才标记已验证。
SHOPLENS_MODEL_PROVIDER=offline

# 已验证的服务商：DeepSeek（国内可直连，LangChain 有官方集成包）
# 从环境变量读取，绝不写入代码或提交
SHOPLENS_DEEPSEEK_API_KEY=
SHOPLENS_DEEPSEEK_MODEL=deepseek-chat
SHOPLENS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 图运行限制（服务端硬约束，模型不可覆盖）----------
SHOPLENS_MAX_REPAIR_COUNT=1
SHOPLENS_SQL_STATEMENT_TIMEOUT_MS=3000
SHOPLENS_SQL_MAX_ROWS=200

# ---------- 前端 ----------
# 默认经 Vite /api 代理访问本机 8000。
VITE_API_BASE_URL=
